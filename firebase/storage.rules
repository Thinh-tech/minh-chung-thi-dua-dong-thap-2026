rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function member() { return request.auth != null && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.unitId == request.auth.token.unitId; }
  match /evidence/{unitId}/{criterionId}/{fileName} {
   allow read: if member();
   allow create: if member() && firestore.get(/databases/(default)/documents/settings/campaign).data.locked == false && (request.auth.token.admin == true || request.auth.token.unitId == unitId) && request.resource.size <= 10485760 && (!request.resource.contentType.matches('image/.*') || request.resource.size <= 5242880) && request.resource.contentType.matches('application/pdf|image/jpeg|image/png|image/webp|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
   allow update, delete: if false;
  }
 }
}
